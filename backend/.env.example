# ─── Server ──────────────────────────────────────────────────────────────────
# Copiez ce fichier en ".env" (jamais commité) et ajustez si besoin.
PORT=5000

# ─── Données ─────────────────────────────────────────────────────────────────
# Dossier de la base SQLite, des médias et du secret JWT généré.
# Par défaut : le dossier backend/. Avec Docker, pointez-le vers un volume (ex: /data).
# DATA_DIR=/data

# ─── Sécurité ────────────────────────────────────────────────────────────────
# Secret de signature des sessions (JWT). OPTIONNEL : s'il est absent, un secret aléatoire
# est généré une fois et conservé dans DATA_DIR/jwt.secret. Si vous le définissez, utilisez
# au moins 32 caractères aléatoires :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Comptes : le PREMIER compte créé sur une installation neuve devient super-administrateur.
# Il crée les comptes administrateurs de magasin, qui créent les comptes de leur magasin.
# Il n'y a pas d'inscription publique après le premier compte.
# Derrière un reverse proxy (Caddy, Nginx, Cloudflare...) : nombre de proxys à croire pour
# lire l'IP réelle (en général 1). Laissez vide si le serveur est exposé directement.
TRUST_PROXY=

# CORS : origines autorisées, séparées par des virgules. Vide = toutes (l'API utilise un jeton
# Bearer, pas de cookies). Les applications natives (Android/Electron) sont toujours autorisées.
# Exemple : ALLOWED_ORIGINS=https://image-screen.app
ALLOWED_ORIGINS=

# ─── Cloud ───────────────────────────────────────────────────────────────────
# URL publique du serveur (affichée dans les logs). Vide pour un usage local.
SERVER_URL=

# ─── Téléversements ──────────────────────────────────────────────────────────
# Taille maximale d'une VIDÉO, en Mo (défaut : 5120 = 5 Go). Les vidéos sont écrites sur le disque
# au fur et à mesure : leur taille n'occupe pas la mémoire du serveur.
# MAX_UPLOAD_MB=5120
# Taille maximale d'une IMAGE, en Mo (défaut : 50). Les images sont compressées en mémoire.
# MAX_IMAGE_MB=50

# ─── Emails (mot de passe oublié, invitations de comptes) ───────────────────
# Sans ces variables, pas d'email : les comptes reçoivent un mot de passe saisi par l'administrateur.
# Exemple avec un service SMTP (Brevo, Mailjet, Gmail avec mot de passe d'application...) :
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp-relay.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=identifiant-smtp
# SMTP_PASS=mot-de-passe-smtp
# MAIL_FROM=ImageScreen <no-reply@votredomaine.fr>
# Adresse publique de l'interface web (utilisée dans les liens des emails)
# APP_URL=https://app.votredomaine.fr

